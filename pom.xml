<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.lorenzovicino</groupId>
  <artifactId>ludus</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>ludus</name>
  <description>
    A UCI chess engine in Java, in two acts: classical search with a hand-crafted evaluation,
    then an NNUE with an incrementally updated accumulator.
  </description>
  <url>https://github.com/LorenzoVicino/ludus</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>LorenzoVicino</id>
      <name>Lorenzo Vicino</name>
      <url>https://github.com/LorenzoVicino</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/LorenzoVicino/ludus.git</connection>
    <url>https://github.com/LorenzoVicino/ludus</url>
  </scm>

  <modules>
    <module>ludus-core</module>
    <module>ludus-eval</module>
    <module>ludus-search</module>
    <module>ludus-nnue</module>
    <module>ludus-uci</module>
    <module>ludus-tools</module>
    <module>ludus-server</module>
  </modules>

  <!--
    Spring Boot's BOM is imported inside ludus-server rather than here, deliberately. The engine
    modules must not inherit a web framework's dependency tree: the jar a GUI launches has no
    dependencies, and that property is easier to keep when the framework cannot reach the modules
    that ship. It also keeps the JUnit version this project pins from being overridden for the
    engine while ludus-server uses whichever version Boot tested against.
  -->

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>24</maven.compiler.release>

    <!--
      A JUnit Platform tag expression. The default keeps the slow runs — deep perft, long self-play
      games — out of an ordinary `mvn test` so it stays fast enough to gate every push
      (DESIGN.md §8.3); `-Pslow` inverts it, and `-Dtest.tags=...` overrides it for anything else.
    -->
    <test.tags>!slow</test.tags>

    <junit.version>6.1.3</junit.version>
    <amqp-client.version>5.34.0</amqp-client.version>
    <slf4j.version>2.0.18</slf4j.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>io.github.lorenzovicino</groupId>
        <artifactId>ludus-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.lorenzovicino</groupId>
        <artifactId>ludus-eval</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.lorenzovicino</groupId>
        <artifactId>ludus-search</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.lorenzovicino</groupId>
        <artifactId>ludus-nnue</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Every module tests with JUnit; declaring it once here beats repeating it four times. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <groups>${test.tags}</groups>
            <argLine>-Xmx2g</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven-shade-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- mvn test -Pslow — deep perft and the long self-play games. Minutes, not seconds. -->
      <id>slow</id>
      <properties>
        <test.tags>slow</test.tags>
      </properties>
    </profile>
  </profiles>
</project>
