<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.lorenzovicino</groupId>
    <artifactId>ludus</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>ludus-uci</artifactId>
  <name>ludus-uci</name>
  <description>
    The UCI protocol and the engine entry point. This is the composition root: the only place that
    decides which Evaluator implementation the search runs with.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.lorenzovicino</groupId>
      <artifactId>ludus-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.lorenzovicino</groupId>
      <artifactId>ludus-eval</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.lorenzovicino</groupId>
      <artifactId>ludus-search</artifactId>
    </dependency>
    <!--
      The composition root is the only module that depends on both evaluations, because it is the
      only one that chooses between them. ludus-search deliberately cannot see this dependency.
    -->
    <dependency>
      <groupId>io.github.lorenzovicino</groupId>
      <artifactId>ludus-nnue</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        A GUI launches an engine as one executable, so the modules are shaded into a single
        target/ludus.jar that runs with `java -jar`.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>ludus</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.lorenzovicino.ludus.uci.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
