<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.lorenzovicino</groupId>
    <artifactId>ludus</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ludus-tools</artifactId>
  <name>ludus-tools</name>
  <description>
    Development tooling that never ships inside the engine: the match runner that measures one
    version against another, and the statistics behind the verdict.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.lorenzovicino</groupId>
      <artifactId>ludus-core</artifactId>
    </dependency>
    <!--
      Self-play data generation runs the search in-process rather than through UCI. Millions of
      positions are needed and a subprocess round trip per move would dominate the cost; running it
      directly also hands us the search score, which is half of what a training sample is.
    -->
    <dependency>
      <groupId>io.github.lorenzovicino</groupId>
      <artifactId>ludus-eval</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.lorenzovicino</groupId>
      <artifactId>ludus-search</artifactId>
    </dependency>

    <!--
      The only third-party runtime dependency in the whole project, and it is confined here on
      purpose. ludus-tools is development tooling: it never ships inside the engine jar a GUI
      launches, so the engine keeps its zero-dependency property intact.
    -->
    <dependency>
      <groupId>com.rabbitmq</groupId>
      <artifactId>amqp-client</artifactId>
      <version>${amqp-client.version}</version>
    </dependency>
    <!--
      amqp-client brings slf4j-api 1.7 transitively. Pinning the 2.x api next to the 2.x binding
      keeps the pair consistent: mixing a 2.x binding with the 1.7 api leaves SLF4J hunting for a
      StaticLoggerBinder that no longer exists, and every broker diagnostic goes to a no-op logger
      exactly when something has gone wrong.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <!--
          Two entry points, two jars. One shaded jar can only declare one Main-Class, and
          `java -jar` is a friendlier interface than `java -cp … fully.qualified.Main` for a tool
          that gets invoked from a workflow file.
        -->
        <executions>
          <execution>
            <id>match-runner</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>ludus-match</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <!--
                  Merges META-INF/services instead of letting one jar's copy overwrite another's.
                  SLF4J 2 finds its binding through ServiceLoader, so without this the shaded jar
                  silently falls back to a no-op logger and every broker diagnostic disappears.
                -->
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.lorenzovicino.ludus.tools.MatchMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
          <execution>
            <id>status-generator</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>ludus-status</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <!--
                  Merges META-INF/services instead of letting one jar's copy overwrite another's.
                  SLF4J 2 finds its binding through ServiceLoader, so without this the shaded jar
                  silently falls back to a no-op logger and every broker diagnostic disappears.
                -->
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.lorenzovicino.ludus.tools.StatusMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
