# Build output — never commit compiled artifacts
target/
*.class
bin/
out/

# Maven wrapper keeps its properties file; nothing else under .mvn is ours
.mvn/.develocity/
.mvn/.gradle-enterprise/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace

# OS
Thumbs.db
Desktop.ini
.DS_Store

# NNUE networks and training data — large binaries, distributed via Releases
*.nnue
*.binpack
training/data/
training/runs/
training/__pycache__/
training/.venv/
venv/

# Match and benchmark output
*.pgn
*.log
