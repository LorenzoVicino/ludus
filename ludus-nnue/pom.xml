<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.lorenzovicino</groupId>
    <artifactId>ludus</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>ludus-nnue</artifactId>
  <name>ludus-nnue</name>
  <description>
    Act II: a neural network evaluation, as a second implementation of the Evaluator interface.
    ludus-search does not depend on this module and never learns it exists.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.lorenzovicino</groupId>
      <artifactId>ludus-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.lorenzovicino</groupId>
      <artifactId>ludus-eval</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        The Vector API is an incubator module, so it has to be requested to compile against and again
        to run. This is the reason the network lives in a module of its own: the flag stays here
        instead of spreading over a build that does not need it.

        At run time it is optional. A GUI launches an engine as a bare `java -jar`, so the vectorised
        class simply fails to load there and DotProduct falls back to the scalar loop.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>--add-modules</arg>
            <arg>jdk.incubator.vector</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- So the tests exercise the path a benchmark run will actually take. -->
          <argLine>-Xmx2g --add-modules jdk.incubator.vector</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
